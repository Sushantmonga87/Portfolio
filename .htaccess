# Sushant Monga Portfolio - Apache configuration

Options -Indexes

DirectoryIndex index.html index.php

# --------------------------------------------------
# HTTPS + canonical non-www URL
# --------------------------------------------------
RewriteEngine On

# Force HTTPS and remove www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.sushantmonga\.in$ [NC]
RewriteRule ^ https://sushantmonga.in%{REQUEST_URI} [R=301,L]

# --------------------------------------------------
# Do not rewrite existing files/directories
# --------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --------------------------------------------------
# Optional clean extensionless URLs
# /about.php -> /about
# Only applies when the .php file actually exists.
# --------------------------------------------------
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/.]+?)/?$ $1.php [L]

# --------------------------------------------------
# Security
# --------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --------------------------------------------------
# Compression
# --------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# --------------------------------------------------
# Browser caching for static assets
# --------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --------------------------------------------------
# Prevent access to common sensitive files
# --------------------------------------------------
<FilesMatch "(^\.|composer\.(json|lock)|package(-lock)?\.json|\.env|.*\.(sql|bak|old|log)$)">
    Require all denied
</FilesMatch>
